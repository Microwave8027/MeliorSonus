CREATE TABLE SavedSheet (
    mxl TEXT NOT NULL PRIMARY KEY,
    pdf_icon TEXT NOT NULL,
    title TEXT NOT NULL,
    composer TEXT NOT NULL,
    song_length_bars INTEGER NOT NULL DEFAULT 0,
    genres TEXT NOT NULL DEFAULT '',
    instruments TEXT NOT NULL DEFAULT '',
    saved_at INTEGER NOT NULL DEFAULT 0
);

insertSavedSheet:
INSERT OR REPLACE INTO SavedSheet(mxl, pdf_icon, title, composer, song_length_bars, genres, instruments, saved_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getAllSavedSheets:
SELECT * FROM SavedSheet ORDER BY saved_at DESC;

getSavedSheetByMxl:
SELECT * FROM SavedSheet WHERE mxl = ?;

deleteSavedSheet:
DELETE FROM SavedSheet WHERE mxl = ?;

countSavedSheets:
SELECT COUNT(*) FROM SavedSheet;

checkExists:
SELECT EXISTS(SELECT 1 FROM SavedSheet WHERE mxl = ? LIMIT 1);